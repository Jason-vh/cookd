{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["vite/client", "bun"]
  },
  // `src` only, once — which quietly left the 600-line authoritative game
  // server, its save store and the build config unchecked, while `bun run
  // check` reported success. The lint is type-aware and did cover them, so this
  // was less bad than it sounds, but "types are gated" was not true.
  "include": ["src", "server", "docs", "vite.config.ts"]
}
