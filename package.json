{
  "name": "cookd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "PORT=5274 bun run --hot server/index.ts",
    "serve": "bun run server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "bun run build && bun run serve",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/three": "^0.180.0",
    "lefthook": "^2.1.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
